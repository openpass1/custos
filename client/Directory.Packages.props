<Project>

  <!-- Central package versions. Every library must be GPL-3.0 compatible (MIT, Apache-2.0, BSD, LGPL). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Service: MIT -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="11.0.0" />
    <!-- Logging: Apache-2.0 -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.EventLog" Version="4.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Local database: MIT (Microsoft.Data.Sqlite), Apache-2.0 (SQLitePCLRaw), public domain (SQLite) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- DPAPI for stored passwords: MIT -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <!-- ZIP archives (streaming, AES-256): MIT -->
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <!-- WMI, for the shadow copies (VSS): MIT -->
    <PackageVersion Include="System.Management" Version="11.0.0" />
    <!-- Tests only, not shipped -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
