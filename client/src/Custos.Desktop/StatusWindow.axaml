<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Custos.Desktop"
        xmlns:g="using:Custos.Gui"
        x:Class="Custos.Desktop.StatusWindow"
        x:ClassModifier="internal"
        x:DataType="p:MainViewModel"
        Title="{x:Static g:Strings.StatusTitle}"
        Icon="/Assets/custos.ico"
        Width="960" Height="460" MinWidth="560" MinHeight="280"
        WindowStartupLocation="CenterScreen">

  <!-- The window of a user who gets only the state of the backups (tray modes «Только состояние» and «Скрыт», section 4):
       the tasks with their last and next runs, the state of the service; no buttons for changes (StatusForm of Custos.exe). -->
  <DockPanel Margin="12,12,12,0">
    <TextBlock DockPanel.Dock="Top" Classes="title" Text="{x:Static g:Strings.StatusTitle}" Margin="10,4,10,10" />
    <Grid DockPanel.Dock="Bottom" Height="36" ColumnDefinitions="Auto,*,Auto" Margin="6,0">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Ellipse Classes="dot" Classes.ok="{Binding ServiceOk}" />
        <TextBlock Classes="small var" Text="{Binding ServiceText}" />
      </StackPanel>
      <TextBlock Grid.Column="2" Classes="small var" Text="{Binding VersionText}" VerticalAlignment="Center" />
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Classes="note" Text="{x:Static g:Strings.StatusNote}" TextWrapping="Wrap" Margin="10,8,10,0" />
    <Border Classes="pane">
      <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,4,8,6" IsVisible="{Binding HasSnapshot}">
          <DockPanel MinWidth="900">
            <Border DockPanel.Dock="Top" Classes="divider" Height="40" Margin="0,0,0,4">
              <Grid ColumnDefinitions="160,130,170,150,200,*" Margin="0">
                <TextBlock Classes="key" Text="{x:Static g:Strings.ColumnTask}" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="1" Classes="key" Text="{x:Static g:Strings.ColumnType}" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="2" Classes="key" Text="{x:Static g:Strings.ColumnSchedule}" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="3" Classes="key" Text="{x:Static g:Strings.ColumnLastRun}" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="4" Classes="key" Text="{x:Static g:Strings.ColumnResult}" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="5" Classes="key" Text="{x:Static g:Strings.ColumnNextRun}" VerticalAlignment="Center" Margin="12,0" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Tasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:TaskRow">
                  <Grid Height="48" ColumnDefinitions="160,130,170,150,200,*">
                    <Grid ColumnDefinitions="Auto,*" Margin="12,0">
                      <p:Icon Classes="state" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.bad="{Binding IsBad}"
                              Classes.run="{Binding IsRun}" Classes.none="{Binding IsNone}" Kind="{Binding StateIcon}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Type}" />
                    <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Schedule}" ToolTip.Tip="{Binding Schedule}" />
                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding LastRun}" />
                    <Border Grid.Column="4" Classes="st" Margin="12,0,0,0" Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}"
                            Classes.bad="{Binding IsBad}" Classes.run="{Binding IsRun}" Classes.none="{Binding IsNone}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <p:Ring Value="{Binding Percent}" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                        <p:Icon Kind="{Binding ResultIcon}" IsVisible="{Binding HasResultIcon}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Result}" />
                      </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="5" Classes="cell" Text="{Binding NextRun}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding !HasSnapshot}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="24">
          <p:Icon Kind="link_off" Size="40" Foreground="{DynamicResource OnSurfaceVariant}" />
          <TextBlock Text="{Binding EmptyText}" Classes="var" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
        </StackPanel>
      </Panel>
    </Border>
  </DockPanel>
</Window>
