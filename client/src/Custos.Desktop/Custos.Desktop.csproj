<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The windows of the new CUSTOS interface in Material Design 3, on Avalonia (thread «Перевести клиент на Avalonia»):
    the main window, the task editor, the dialogs, the tray icon and its menu, the colour schemes. No code of one
    operating system here: what differs between Windows and macOS comes through DesktopPlatform. The Windows program
    is src/Custos.Windows (Custos.exe of the standard edition); CUSTOS for macOS moves onto it later.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Custos.Desktop</RootNamespace>
    <AssemblyName>Custos.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia runs on x64 and arm64 alike. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- LibraryImport of DwmSetWindowAttribute (the colour of the title bar on Windows 11, TitleBar.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The files shared with Custos.Gui (UiState.cs) know they are in the new window. -->
    <DefineConstants>$(DefineConstants);CUSTOS_DESKTOP</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Custos.Core\Custos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <!-- The connection to the service, the texts and the remembered look are the ones of Custos.exe, shared as files. -->
  <ItemGroup>
    <Compile Include="..\Custos.Gui\ServiceMonitor.cs" Link="Shared\ServiceMonitor.cs" />
    <Compile Include="..\Custos.Gui\UiState.cs" Link="Shared\UiState.cs" />
    <Compile Include="..\Custos.Gui\Strings.cs" Link="Shared\Strings.cs" />
    <Compile Include="..\Custos.Gui\Strings.g.cs" Link="Shared\Strings.g.cs" />
    <EmbeddedResource Include="..\Custos.Gui\Resources\Strings.resx" Link="Shared\Strings.resx" LogicalName="Custos.Gui.Resources.Strings.resources" />
    <EmbeddedResource Include="..\Custos.Gui\Resources\Strings.ru.resx" Link="Shared\Strings.ru.resx" LogicalName="Custos.Gui.Resources.Strings.ru.resources" WithCulture="true" Culture="ru" />
    <!-- Texts of the new windows only: Resources\DesktopStrings.tsv, made into .resx by tools/make-strings.py. -->
    <EmbeddedResource Update="Resources\DesktopStrings.resx" LogicalName="Custos.Desktop.Resources.DesktopStrings.resources" />
    <EmbeddedResource Update="Resources\DesktopStrings.ru.resx" LogicalName="Custos.Desktop.Resources.DesktopStrings.ru.resources" WithCulture="true" Culture="ru" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Custos" />
    <InternalsVisibleTo Include="custos-gui" />
    <InternalsVisibleTo Include="CustosDesktopShots" />
  </ItemGroup>

</Project>
