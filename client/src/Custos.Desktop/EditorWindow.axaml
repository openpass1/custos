<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Custos.Desktop"
        xmlns:g="using:Custos.Gui"
        x:Class="Custos.Desktop.EditorWindow"
        x:ClassModifier="internal"
        x:DataType="p:EditorModel"
        Title="{Binding Title}"
        Icon="/Assets/custos.ico"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <!-- The task editor: the pages on the left (navigation drawer), the open page in a rounded pane, «Отмена» and «Сохранить»
       under it. Every kind of item of a page (EditorModel.cs) has its template here. -->
  <Window.DataTemplates>

    <DataTemplate DataType="p:HeadingItem">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,18,0,2">
        <TextBlock Classes="section" Text="{Binding Text}" VerticalAlignment="Center" />
        <p:Icon Kind="help" Size="18" Foreground="{DynamicResource OnSurfaceVariant}" IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding Help}"
                VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="p:NoteItem">
      <Panel>
        <TextBlock Classes="note" Text="{Binding Text}" IsVisible="{Binding !Warning}" />
        <Border Classes="info warn" IsVisible="{Binding Warning}">
          <Grid ColumnDefinitions="Auto,*">
            <p:Icon Kind="warning" Filled="True" Size="20" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20" />
          </Grid>
        </Border>
      </Panel>
    </DataTemplate>

    <DataTemplate DataType="p:FieldItem">
      <p:Field Label="{Binding Label}" Hint="{Binding Hint}" TrailingIcon="{Binding Icon}" Width="{Binding Width}" Classes.icon="{Binding HasIcon}">
        <TextBox Text="{Binding Value, Mode=OneWay}" Height="{Binding Height}" Classes.multi="{Binding Multiline}" />
      </p:Field>
    </DataTemplate>

    <DataTemplate DataType="p:ChoiceItem">
      <p:Field Label="{Binding Label}" Hint="{Binding Hint}" Width="{Binding Width}">
        <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding Selected, Mode=OneTime}" />
      </p:Field>
    </DataTemplate>

    <DataTemplate DataType="p:SwitchItem">
      <Border Classes="switchrow" Classes.card="{Binding Card}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" />
            <TextBlock Classes="small var" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" LineHeight="18" />
          </StackPanel>
          <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding On, Mode=OneTime}" Margin="24,0,0,0" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="p:CheckItem">
      <CheckBox Theme="{StaticResource M3Check}" IsChecked="{Binding On, Mode=OneTime}" Margin="{Binding Offset}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="small var" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" LineHeight="18" />
        </StackPanel>
      </CheckBox>
    </DataTemplate>

    <DataTemplate DataType="p:CheckFieldItem">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Theme="{StaticResource M3Check}" Classes="inline" IsChecked="{Binding On, Mode=OneTime}" Content="{Binding Title}" VerticalAlignment="Center" />
        <p:Field Classes="compact" Width="72"><TextBox Text="{Binding Value, Mode=OneWay}" /></p:Field>
        <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="p:CheckChoiceItem">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Theme="{StaticResource M3Check}" Classes="inline" IsChecked="{Binding On, Mode=OneTime}" Content="{Binding Title}" VerticalAlignment="Center" />
        <p:Field Classes="compact" Width="200">
          <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding Selected, Mode=OneTime}" />
        </p:Field>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="p:PhraseItem">
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="{Binding Offset}">
        <TextBlock Text="{Binding Prefix}" VerticalAlignment="Center" />
        <p:Field Classes="compact" Width="72"><TextBox Text="{Binding Value, Mode=OneWay}" /></p:Field>
        <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" IsVisible="{Binding Suffix, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="p:RadioItem">
      <RadioButton Theme="{StaticResource M3Radio}" GroupName="{Binding Group}" IsChecked="{Binding On, Mode=OneTime}" Margin="{Binding Offset}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" IsVisible="{Binding !HasValue}" />
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasValue}" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            <p:Field Classes="compact" Width="72" Margin="0,-10,0,-10"><TextBox Text="{Binding Value, Mode=OneWay}" /></p:Field>
            <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="small var" Text="{Binding Hint}" IsVisible="{Binding HasHint}" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,4" />
        </StackPanel>
      </RadioButton>
    </DataTemplate>

    <DataTemplate DataType="p:SegmentsItem">
      <StackPanel Spacing="8">
        <TextBlock Classes="small var" Text="{Binding Label}" />
        <Border Classes="segments">
          <ItemsControl ItemsSource="{Binding Segments}" Margin="-1,0,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:Segment">
                <RadioButton Theme="{StaticResource Segment}" GroupName="{Binding Group}" IsChecked="{Binding On, Mode=OneTime}" Content="{Binding Text}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="p:ChipsItem">
      <StackPanel Spacing="8">
        <TextBlock Classes="small var" Text="{Binding Label}" />
        <ItemsControl ItemsSource="{Binding Chips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="p:Chip">
              <ToggleButton Theme="{StaticResource Chip}" IsChecked="{Binding On, Mode=OneTime}" Content="{Binding Text}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="p:CardItem">
      <Border Classes="card">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Classes="tile" VerticalAlignment="Top">
            <p:Icon Kind="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,8,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
            <TextBlock Classes="small var" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" TextWrapping="Wrap" LineHeight="18" />
            <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="0,6,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:CardTag">
                  <Border Classes="tag" Classes.accent="{Binding Accent}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <p:Icon Kind="{Binding Icon}" Size="16" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Text}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Theme="{StaticResource IconButton}" ToolTip.Tip="{x:Static g:Strings.ToolEdit}"><p:Icon Kind="edit" Size="20" /></Button>
            <Button Theme="{StaticResource IconButton}" ToolTip.Tip="{x:Static g:Strings.ToolDelete}"><p:Icon Kind="delete" Size="20" /></Button>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="p:ButtonItem">
      <Button Theme="{StaticResource TonalButton}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <p:Icon Kind="{Binding Icon}" Size="18" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate DataType="p:InfoItem">
      <Border Classes="info">
        <Grid ColumnDefinitions="Auto,*">
          <p:Icon Kind="{Binding Icon}" Size="20" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="4">
            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextWrapping="Wrap" FontSize="13.5" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="p:RowItem">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>
  </Window.DataTemplates>

  <Panel>
    <Grid ColumnDefinitions="272,*" RowDefinitions="*,Auto" Margin="0,0,12,0">

      <!-- Pages of the editor -->
      <DockPanel Grid.RowSpan="2" Margin="12,16,12,12">
        <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" TextWrapping="Wrap" Margin="16,4,16,16" />
        <TextBlock DockPanel.Dock="Bottom" Classes="small var" Text="{Binding Revision}" TextWrapping="Wrap" Margin="16,8,16,4" />
        <ListBox Classes="nav" Theme="{StaticResource M3List}" ItemContainerTheme="{StaticResource NavItem}" ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding Page}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="p:EditorPage">
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0" VerticalAlignment="Center">
                <p:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- The open page -->
      <Border Name="PagePane" Grid.Column="1" Classes="pane" Margin="0,12,0,0">
        <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="36,28,36,32" MaxWidth="720" HorizontalAlignment="Left" DataContext="{Binding Page}" x:DataType="p:EditorPage">
            <TextBlock Classes="pagetitle" Text="{Binding Title}" />
            <TextBlock Classes="note" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Margin="0,6,0,0" FontSize="14" />
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,16,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Buttons -->
      <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,14">
        <Button Theme="{StaticResource OutlinedButton}" Content="{x:Static g:Strings.ButtonCancel}" Click="OnCancel" IsCancel="True" />
        <Button Theme="{StaticResource FilledButton}" Padding="16,0,24,0" Click="OnSave">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <p:Icon Kind="check" Size="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static p:DesktopStrings.Save}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Snackbar -->
    <Panel Name="Snack" IsVisible="False" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="296,0,0,68" MaxWidth="560">
      <Border Classes="snackshadow" />
      <Border Classes="snack">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Name="SnackText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,8,16,8" />
          <Button Grid.Column="1" Theme="{StaticResource TextButton}" Content="{x:Static g:Strings.ButtonOk}" Click="OnSnackClose"
                  Foreground="{DynamicResource InversePrimary}" />
        </Grid>
      </Border>
    </Panel>
  </Panel>
</Window>
