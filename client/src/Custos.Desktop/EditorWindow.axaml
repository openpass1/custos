<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Custos.Desktop"
        xmlns:g="using:Custos.Gui"
        x:Class="Custos.Desktop.EditorWindow"
        x:ClassModifier="internal"
        x:DataType="p:EditorModel"
        Title="{Binding Title}"
        Icon="/Assets/custos.ico"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <!-- The task editor: the pages on the left (navigation drawer), the open page in a rounded pane, what stops saving,
       «Отмена» and «Сохранить» under it. The pieces of a page are drawn by FormView (Form.cs). -->
  <Grid ColumnDefinitions="272,*" RowDefinitions="*,Auto" Margin="0,0,12,0">

    <!-- Pages of the editor -->
    <DockPanel Grid.RowSpan="2" Margin="12,16,12,12">
      <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" TextWrapping="Wrap" Margin="16,4,16,16" />
      <TextBlock DockPanel.Dock="Bottom" Classes="small var" Text="{Binding Revision}" TextWrapping="Wrap" Margin="16,8,16,4" />
      <ListBox Name="PageList" Classes="nav" Theme="{StaticResource M3List}" ItemContainerTheme="{StaticResource NavItem}" ItemsSource="{Binding Pages}"
               SelectedItem="{Binding Page}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:EditorPage">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0" VerticalAlignment="Center">
              <p:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The open page -->
    <Border Name="PagePane" Grid.Column="1" Classes="pane" Margin="0,12,0,0">
      <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,32" MaxWidth="720" HorizontalAlignment="Left" DataContext="{Binding Page}" x:DataType="p:EditorPage">
          <TextBlock Classes="pagetitle" Text="{Binding Title}" />
          <TextBlock Classes="note" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Margin="0,6,0,0" FontSize="14" TextWrapping="Wrap" />
          <p:FormView Items="{Binding Items}" Margin="0,16,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- What stops saving, and the buttons -->
    <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,14,0,14">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasProblem}" VerticalAlignment="Center" Margin="8,0,16,0">
        <p:Icon Kind="error" Filled="True" Size="20" Foreground="{DynamicResource Error}" VerticalAlignment="Top" />
        <TextBlock Name="ProblemText" Text="{Binding Problem}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" VerticalAlignment="Center"
                   MaxWidth="560" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Name="CancelButton" Theme="{StaticResource OutlinedButton}" Content="{x:Static g:Strings.ButtonCancel}" Click="OnCancel" IsCancel="True" />
        <Button Name="SaveButton" Theme="{StaticResource FilledButton}" Padding="16,0,24,0" Click="OnSave">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <p:Icon Kind="check" Size="18" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static p:DesktopStrings.Save}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
