<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:Custos.Desktop"
        xmlns:g="using:Custos.Gui"
        x:Class="Custos.Desktop.EditorWindow"
        x:ClassModifier="internal"
        x:DataType="p:EditorModel"
        Title="{Binding Title}"
        Icon="/Assets/custos.ico"
        Width="1040" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <!-- The task editor: the pages on the left (navigation drawer), the open page in a rounded pane, what stops saving,
       «Отмена» and «Сохранить» under it. The pieces of a page are drawn by FormView (Form.cs). -->
  <Grid Name="EditorLayout" ColumnDefinitions="210,*" RowDefinitions="Auto,*,Auto" Margin="0,0,8,0">

    <ComboBox Name="CompactPageList" Grid.ColumnSpan="2" IsVisible="False" Margin="8,8,0,0" HorizontalAlignment="Stretch"
              ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="p:EditorPage">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <p:Icon Kind="{Binding Icon}" Size="20" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <!-- Pages of the editor -->
    <DockPanel Name="PageSidebar" Grid.Row="1" Grid.RowSpan="2" Margin="8,10,8,8">
      <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding Title}" TextWrapping="Wrap" Margin="12,2,12,8" />
      <TextBlock DockPanel.Dock="Bottom" Classes="small var" Text="{Binding Revision}" TextWrapping="Wrap" Margin="16,8,16,4" />
      <ListBox Name="PageList" Classes="nav" Theme="{StaticResource M3List}" ItemContainerTheme="{StaticResource NavItem}" ItemsSource="{Binding Pages}"
               SelectedItem="{Binding Page}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:EditorPage">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,0" VerticalAlignment="Center">
              <p:Icon Kind="{Binding Icon}" Size="20" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- The open page -->
    <Border Name="PagePane" Grid.Column="1" Grid.Row="1" Classes="pane" Margin="0,8,0,0">
      <ScrollViewer Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="PageContent" Margin="20,12,20,16" MaxWidth="760" HorizontalAlignment="Left" DataContext="{Binding Page}" x:DataType="p:EditorPage">
          <TextBlock Classes="pagetitle" Text="{Binding Title}" />
          <TextBlock Classes="note" Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" Margin="0,2,0,0" FontSize="12.5" TextWrapping="Wrap" />
          <p:FormView Name="EditorForm" Items="{Binding Items}" Margin="0,6,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- What stops saving, and the buttons -->
    <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,8,0,8">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding HasProblem}" VerticalAlignment="Center" Margin="8,0,16,0">
        <p:Icon Kind="error" Filled="True" Size="20" Foreground="{DynamicResource Error}" VerticalAlignment="Top" />
        <TextBlock Name="ProblemText" Grid.Column="1" Text="{Binding Problem}" Foreground="{DynamicResource Error}" TextWrapping="Wrap" VerticalAlignment="Center"
                   MaxWidth="560" />
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Name="CancelButton" Theme="{StaticResource OutlinedButton}" Content="{x:Static g:Strings.ButtonCancel}" Click="OnCancel" IsCancel="True" />
        <Button Name="SaveButton" Theme="{StaticResource FilledButton}" Padding="16,0,24,0" Click="OnSave">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <p:Icon Kind="check" Size="16" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static p:DesktopStrings.Save}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
