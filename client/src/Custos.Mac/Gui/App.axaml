<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Custos.Mac.Gui.App"
             x:ClassModifier="internal"
             RequestedThemeVariant="Default">

  <!--
    Material 3 colours. The scheme roles below are replaced at the start by the scheme of the user (Palettes.cs, neutral
    grey unless another is picked in Settings → Look); error, green and amber stay as here. Light and dark follow macOS
    unless the settings say otherwise.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Primary" Color="#4A5C92" />
          <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PrimaryContainer" Color="#DBE1FF" />
          <SolidColorBrush x:Key="OnPrimaryContainer" Color="#314578" />
          <SolidColorBrush x:Key="SecondaryContainer" Color="#DDE2F9" />
          <SolidColorBrush x:Key="OnSecondaryContainer" Color="#414659" />
          <SolidColorBrush x:Key="Error" Color="#BA1A1A" />
          <SolidColorBrush x:Key="ErrorContainer" Color="#FFDAD6" />
          <SolidColorBrush x:Key="OnErrorContainer" Color="#93000A" />
          <SolidColorBrush x:Key="Surface" Color="#FAF8FF" />
          <SolidColorBrush x:Key="OnSurface" Color="#1A1B21" />
          <SolidColorBrush x:Key="OnSurfaceVariant" Color="#45464F" />
          <SolidColorBrush x:Key="SurfaceContainerLowest" Color="#FFFFFF" />
          <SolidColorBrush x:Key="SurfaceContainerLow" Color="#F4F3FA" />
          <SolidColorBrush x:Key="SurfaceContainer" Color="#EEEDF4" />
          <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#E8E7EF" />
          <SolidColorBrush x:Key="SurfaceContainerHighest" Color="#E3E2E9" />
          <SolidColorBrush x:Key="Outline" Color="#757680" />
          <SolidColorBrush x:Key="OutlineVariant" Color="#C5C6D0" />
          <SolidColorBrush x:Key="InverseSurface" Color="#2F3036" />
          <SolidColorBrush x:Key="InverseOnSurface" Color="#F1F0F7" />
          <SolidColorBrush x:Key="InversePrimary" Color="#B3C5FF" />
          <SolidColorBrush x:Key="Ok" Color="#006C4D" />
          <SolidColorBrush x:Key="OkContainer" Color="#B4F2D4" />
          <SolidColorBrush x:Key="OnOkContainer" Color="#00513A" />
          <SolidColorBrush x:Key="Warn" Color="#F09727" />
          <SolidColorBrush x:Key="WarnContainer" Color="#FFDCBD" />
          <SolidColorBrush x:Key="OnWarnContainer" Color="#693C00" />
          <!-- State layers: the content colour at 8 % (hover) and 10 % (pressed). -->
          <SolidColorBrush x:Key="HoverLayer" Color="#141A1B21" />
          <SolidColorBrush x:Key="PressedLayer" Color="#1A1A1B21" />
          <SolidColorBrush x:Key="Shade" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Primary" Color="#B3C5FF" />
          <SolidColorBrush x:Key="OnPrimary" Color="#192E60" />
          <SolidColorBrush x:Key="PrimaryContainer" Color="#314578" />
          <SolidColorBrush x:Key="OnPrimaryContainer" Color="#DBE1FF" />
          <SolidColorBrush x:Key="SecondaryContainer" Color="#414659" />
          <SolidColorBrush x:Key="OnSecondaryContainer" Color="#DDE2F9" />
          <SolidColorBrush x:Key="Error" Color="#FFB4AB" />
          <SolidColorBrush x:Key="ErrorContainer" Color="#93000A" />
          <SolidColorBrush x:Key="OnErrorContainer" Color="#FFDAD6" />
          <SolidColorBrush x:Key="Surface" Color="#121318" />
          <SolidColorBrush x:Key="OnSurface" Color="#E3E2E9" />
          <SolidColorBrush x:Key="OnSurfaceVariant" Color="#C5C6D0" />
          <SolidColorBrush x:Key="SurfaceContainerLowest" Color="#0D0E13" />
          <SolidColorBrush x:Key="SurfaceContainerLow" Color="#1A1B21" />
          <SolidColorBrush x:Key="SurfaceContainer" Color="#1E1F25" />
          <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#292A2F" />
          <SolidColorBrush x:Key="SurfaceContainerHighest" Color="#33343A" />
          <SolidColorBrush x:Key="Outline" Color="#8F909A" />
          <SolidColorBrush x:Key="OutlineVariant" Color="#45464F" />
          <SolidColorBrush x:Key="InverseSurface" Color="#E3E2E9" />
          <SolidColorBrush x:Key="InverseOnSurface" Color="#2F3036" />
          <SolidColorBrush x:Key="InversePrimary" Color="#4A5C92" />
          <SolidColorBrush x:Key="Ok" Color="#6BDBAD" />
          <SolidColorBrush x:Key="OkContainer" Color="#005139" />
          <SolidColorBrush x:Key="OnOkContainer" Color="#88F8C7" />
          <SolidColorBrush x:Key="Warn" Color="#E08A18" />
          <SolidColorBrush x:Key="WarnContainer" Color="#693C00" />
          <SolidColorBrush x:Key="OnWarnContainer" Color="#FFDCBD" />
          <SolidColorBrush x:Key="HoverLayer" Color="#14E3E2E9" />
          <SolidColorBrush x:Key="PressedLayer" Color="#1AE3E2E9" />
          <SolidColorBrush x:Key="Shade" Color="#66000000" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Custos/Styles/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4A5C92" RegionColor="#FAF8FF" />
        <ColorPaletteResources x:Key="Dark" Accent="#B3C5FF" RegionColor="#121318" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Custos/Styles/M3.axaml" />
  </Application.Styles>
</Application>
