<Project Sdk="Microsoft.NET.Sdk">

  <!-- Custos.Updater.exe: stops the service, replaces the program files, starts the service (section 3.1, A.10).
       The service runs a copy of it from C:\ProgramData\CUSTOS\updates, so it references nothing but .NET itself:
       the four files Custos.Updater.* are all it needs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CustosWindowsTargetFramework)</TargetFramework>
    <RuntimeIdentifier>$(CustosRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>Custos.Updater</RootNamespace>
    <AssemblyName>Custos.Updater</AssemblyName>
    <ApplicationIcon>..\Custos.Gui\Resources\custos.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
