<Project Sdk="Microsoft.NET.Sdk">

  <!-- CustosService.exe: the Windows service (LocalSystem) that does all the work. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(CustosWindowsTargetFramework)</TargetFramework>
    <RuntimeIdentifier>$(CustosRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>Custos.Service</RootNamespace>
    <AssemblyName>CustosService</AssemblyName>
    <ApplicationIcon>..\Custos.Gui\Resources\custos.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Custos.Core\Custos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <!-- Legacy edition: the event log library with its Windows code for .NET 6 (Directory.Packages.props). -->
  <ItemGroup Condition="'$(CustosLegacy)' == 'true'">
    <PackageReference Include="System.Diagnostics.EventLog" />
  </ItemGroup>

</Project>
