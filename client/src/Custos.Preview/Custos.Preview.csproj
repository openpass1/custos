<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CustosPreview.exe: a trial of the main window in Material Design 3 on Avalonia (thread «Оценить Material 3 в клиенте»).
    Only shows: it reads tasks, states, the log, the history and the progress from the running service like Custos.exe,
    and changes nothing. Not part of the installer; CI makes a separate zip (.github/workflows/preview.yml).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CustosPreview</AssemblyName>
    <RootNamespace>Custos.Preview</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Custos.Gui\Resources\custos.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia runs on x64 and arm64 alike; the Windows zip is published for win-x64. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- LibraryImport of DwmSetWindowAttribute (the colour of the title bar on Windows 11). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Custos.Core\Custos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <!-- The connection to the service and the texts are the ones of Custos.exe, shared as files, not copied. -->
  <ItemGroup>
    <Compile Include="..\Custos.Gui\ServiceMonitor.cs" Link="Shared\ServiceMonitor.cs" />
    <Compile Include="..\Custos.Gui\Strings.cs" Link="Shared\Strings.cs" />
    <Compile Include="..\Custos.Gui\Strings.g.cs" Link="Shared\Strings.g.cs" />
    <EmbeddedResource Include="..\Custos.Gui\Resources\Strings.resx" Link="Shared\Strings.resx" LogicalName="Custos.Gui.Resources.Strings.resources" />
    <EmbeddedResource Include="..\Custos.Gui\Resources\Strings.ru.resx" Link="Shared\Strings.ru.resx" LogicalName="Custos.Gui.Resources.Strings.ru.resources" WithCulture="true" Culture="ru" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Exclude="Assets\**\*.txt" />
    <!-- The licences go next to the program in the zip. -->
    <None Include="..\..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES-PREVIEW.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\Roboto-LICENSE.txt" Link="Roboto-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Debug symbols are of no use on the test machine; those of Skia and HarfBuzz alone are 100 MB. -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- tests/Custos.Preview.Shots draws the window into pictures for the CI summary. -->
    <InternalsVisibleTo Include="CustosPreviewShots" />
  </ItemGroup>

</Project>
