<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="using:Custos.Preview">

  <!-- Looks of the controls in Material 3. Each control theme has its own template, so it does not depend on the
       insides of the Fluent theme, which stays only for scroll bars, text boxes and the like. -->

  <!-- Toolbar item: icon in a 56 x 32 pill indicator, label under it. -->
  <ControlTheme x:Key="{x:Type p:ToolButton}" TargetType="p:ToolButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="86" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="4" Background="Transparent" VerticalAlignment="Center">
          <Border Name="ind" Width="56" Height="32" CornerRadius="16" HorizontalAlignment="Center" Background="{TemplateBinding Background}">
            <p:Icon Name="icon" Kind="{TemplateBinding IconKind}" Size="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{TemplateBinding Label}" FontSize="12" FontWeight="Medium" LetterSpacing="0.3" HorizontalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#ind">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#ind">
      <Setter Property="Background" Value="{DynamicResource PressedLayer}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="^.go /template/ p|Icon#icon">
      <Setter Property="Foreground" Value="{DynamicResource Ok}" />
      <Setter Property="Filled" Value="True" />
    </Style>
    <Style Selector="^.halt /template/ p|Icon#icon">
      <Setter Property="Foreground" Value="{DynamicResource Error}" />
      <Setter Property="Filled" Value="True" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type p:ToolToggle}" TargetType="p:ToolToggle">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="86" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="4" Background="Transparent" VerticalAlignment="Center">
          <Border Name="ind" Width="56" Height="32" CornerRadius="16" HorizontalAlignment="Center" Background="{TemplateBinding Background}">
            <p:Icon Name="icon" Kind="{TemplateBinding IconKind}" Size="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Name="label" Text="{TemplateBinding Label}" FontSize="12" FontWeight="Medium" LetterSpacing="0.3" HorizontalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#ind">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
    <Style Selector="^:checked /template/ Border#ind">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
    </Style>
    <Style Selector="^:checked /template/ p|Icon#icon">
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
      <Setter Property="Filled" Value="True" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    </Style>
  </ControlTheme>

  <!-- The two halves of the «Создать» extended FAB. -->
  <ControlTheme x:Key="FabPart" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainer}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,0,16,0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource PressedLayer}" />
    </Style>
  </ControlTheme>

  <!-- A row of a list: rounded, a state layer on hover, the secondary container when selected. -->
  <ControlTheme x:Key="M3ListItem" TargetType="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
    <Style Selector="^:selected /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="M3List" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource M3ListItem}" />
  </ControlTheme>

  <!-- Secondary tab with an icon: a line under the open one. -->
  <ControlTheme x:Key="TabButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}" Height="48">
          <ContentPresenter Content="{TemplateBinding Content}" Margin="16,0" VerticalAlignment="Center" />
          <Border Name="line" Height="3" CornerRadius="3,3,0,0" Margin="8,0" VerticalAlignment="Bottom"
                  Background="{DynamicResource Primary}" IsVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    </Style>
    <Style Selector="^:checked /template/ Border#line">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>

  <!-- Filter chip: outlined, filled with the secondary container and a check when on. -->
  <ControlTheme x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Height="32" CornerRadius="8" BorderThickness="1" Padding="12,0,14,0"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <p:Icon Name="check" Kind="check" Size="18" IsVisible="False" />
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
    <Style Selector="^:checked /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="8,0,14,0" />
    </Style>
    <Style Selector="^:checked /template/ p|Icon#check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>
  </ControlTheme>

  <!-- A chip that opens a menu («Показывать: всё ▾»). -->
  <ControlTheme x:Key="MenuChip" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariant}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Height="32" CornerRadius="8" BorderThickness="1" Padding="14,0,8,0"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
            <p:Icon Kind="arrow_drop_down" Size="18" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
  </ControlTheme>

  <!-- Item of a menu in a flyout. -->
  <ControlTheme x:Key="MenuItemButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Height="44" CornerRadius="12" Margin="4,0" Padding="12,0,16,0" Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>
  </ControlTheme>

  <!-- Column header of a table: text, and an arrow on the sorted column. -->
  <ControlTheme x:Key="HeaderButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="{TemplateBinding Background}" Padding="12,0" CornerRadius="8">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
  </ControlTheme>

  <!-- A link in the status bar. -->
  <ControlTheme x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="{TemplateBinding Background}" Padding="8,4" CornerRadius="12">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
  </ControlTheme>

  <!-- Text button (snackbar action). -->
  <ControlTheme x:Key="TextButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="bg" Background="{TemplateBinding Background}" Height="36" Padding="12,0" CornerRadius="18">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#bg">
      <Setter Property="Background" Value="{DynamicResource HoverLayer}" />
    </Style>
  </ControlTheme>

  <!-- M3 pane drag handle: a short pill in the gap between two panes. -->
  <ControlTheme x:Key="DragHandleV" TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Name="pill" Width="4" Height="48" CornerRadius="2" Background="{DynamicResource Outline}" Opacity="0.6"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#pill">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Height" Value="64" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="DragHandleH" TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeDirection" Value="Rows" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Border Name="pill" Width="48" Height="4" CornerRadius="2" Background="{DynamicResource Outline}" Opacity="0.6"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#pill">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="Width" Value="64" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
