<Project Sdk="Microsoft.NET.Sdk">

  <!-- Custos.exe: the interface with the tray icon. Runs in every user session; does no work itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(CustosWindowsTargetFramework)</TargetFramework>
    <RuntimeIdentifier>$(CustosRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Custos.Gui</RootNamespace>
    <AssemblyName>Custos</AssemblyName>
    <ApplicationIcon>Resources\custos.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Custos.Core\Custos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window tests (built and run on Windows only) open the windows with made-up data. -->
    <InternalsVisibleTo Include="Custos.Gui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.ico" LogicalName="Custos.Gui.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
