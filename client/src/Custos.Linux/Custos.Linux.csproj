<Project Sdk="Microsoft.NET.Sdk">

  <!-- CUSTOS for Linux servers (x64 and arm64, glibc 2.28 and later): one program in /opt/custos with two roles.
       Started by systemd with "agent" it is the service (root) that does all the work, the same code as CustosService.exe
       on Windows (compiled from src/Custos.Service with its own platform classes in Platform/). Started from a terminal
       it is the command custos (status, run, log, snapshots …). Built self-contained for linux-x64 and linux-arm64 by
       linux/build-linux.sh: nothing has to be installed on the server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Custos.Linux</RootNamespace>
    <AssemblyName>custos</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>$(DefineConstants);CUSTOS_LINUX</DefineConstants>
    <DefineConstants Condition="'$(CustosPackageManaged)' == 'true'">$(DefineConstants);CUSTOS_PACKAGE_MANAGED</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Languages and formats come from libicu of the system, as for every .NET program on Linux: install.sh installs
         it where it is missing (and switches the service to the invariant mode of .NET where it cannot). -->
    <!-- The service code shared with Windows is marked [SupportedOSPlatform("windows")]; here it is compiled against
         the classes of Linux, so the platform check of the analyzer would only see false alarms. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Custos.Core\Custos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The service: the agent of Windows as it is. -->
  <ItemGroup>
    <Compile Include="..\Custos.Service\Agent\*.cs" Link="Service\Agent\%(Filename)%(Extension)" />
    <Compile Include="..\Custos.Service\Ipc\PipeServer.cs" Link="Service\Ipc\PipeServer.cs" />
    <Compile Include="..\Custos.Service\ServiceLog.cs" Link="Service\ServiceLog.cs" />
    <Compile Include="..\Custos.Service\ServiceLifecycle.cs" Link="Service\ServiceLifecycle.cs" />
  </ItemGroup>

  <!-- Debug symbols are of no use on the server. -->
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Custos.Linux.Tests" />
  </ItemGroup>

</Project>
