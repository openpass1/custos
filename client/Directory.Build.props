<Project>

  <!-- Settings shared by every project under client/. -->
  <PropertyGroup>
    <VersionPrefix>0.5.0</VersionPrefix>
    <Product>CUSTOS</Product>
    <Company>CUSTOS contributors</Company>
    <Copyright>Copyright (C) 2026 CUSTOS contributors. Licensed under GPL-3.0.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1303: the service, updater and tests use English literals on purpose; the GUI takes its texts from resources. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>

    <!-- Windows builds are 64-bit Intel/AMD only (7z.dll x64). Built elsewhere (the macOS client, tests on Linux) the
         assemblies stay AnyCPU: an x64-only assembly does not load into a process on Apple silicon. -->
    <PlatformTarget Condition="'$(OS)' == 'Windows_NT'">x64</PlatformTarget>
    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Lets the Windows projects build on Linux and macOS too (CI and tests). The macOS client is src/Custos.Mac. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
