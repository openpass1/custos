<Project>

  <!-- Settings shared by every project under client/. -->
  <PropertyGroup>
    <VersionPrefix>0.5.0</VersionPrefix>
    <Product>CUSTOS</Product>
    <Company>CUSTOS contributors</Company>
    <Copyright>Copyright (C) 2026 CUSTOS contributors. Licensed under GPL-3.0.</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1303: the service, updater and tests use English literals on purpose; the GUI takes its texts from resources. -->
    <NoWarn>$(NoWarn);CA1303</NoWarn>

    <SatelliteResourceLanguages>en;ru</SatelliteResourceLanguages>
    <!-- Lets the solution build on Linux and macOS too (CI and tests); the product itself runs on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    Two editions are built from the same code:
      standard  .NET 10, 64-bit, Windows 10 / Server 2019 and later (the default);
      legacy    .NET 6, 32-bit, Windows 7 SP1 and 8.1, built with -p:CustosLegacy=true (build.ps1 -Legacy).
    .NET 6 is the last .NET that runs on Windows 7 and 8.1. The legacy edition is released as is and updated only in
    emergencies (client/README.md). The APIs that .NET 7-10 added are filled in by src/Legacy/*.cs, which only the
    legacy build compiles; what cannot work there is switched off through CustosEdition (Custos.Core).
  -->
  <PropertyGroup>
    <CustosLegacy Condition="'$(CustosLegacy)' == ''">false</CustosLegacy>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CustosLegacy)' != 'true'">
    <CustosTargetFramework>net10.0</CustosTargetFramework>
    <CustosWindowsTargetFramework>net10.0-windows</CustosWindowsTargetFramework>
    <CustosRuntimeIdentifier>win-x64</CustosRuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CustosLegacy)' == 'true'">
    <CustosTargetFramework>net6.0</CustosTargetFramework>
    <CustosWindowsTargetFramework>net6.0-windows</CustosWindowsTargetFramework>
    <CustosRuntimeIdentifier>win-x86</CustosRuntimeIdentifier>
    <PlatformTarget>x86</PlatformTarget>
    <DefineConstants>$(DefineConstants);CUSTOS_LEGACY</DefineConstants>
    <!-- .NET 6 is out of support, and the libraries built for .NET 8 and later warn about it: that is known and wanted. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <!-- AWSSDK3000: the AWS SDK falls back to its .NET Standard 2.0 build on .NET 6, which is all S3 needs here. -->
    <NoWarn>$(NoWarn);AWSSDK3000</NoWarn>
    <!-- Its own obj and bin folders, so that both editions can be built one after the other in the same tree. -->
    <BaseIntermediateOutputPath>obj\legacy\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\legacy\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- The missing .NET 7-10 APIs; the compiler attributes are internal, so every project gets its own copy. -->
  <ItemGroup Condition="'$(CustosLegacy)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src\Legacy\CompilerAttributes.cs" Link="Legacy\CompilerAttributes.cs" />
  </ItemGroup>

</Project>
