<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Draws the main window of CustosPreview (src/Custos.Preview) with the made-up tasks into PNG pictures, on Avalonia's
    headless platform: no screen and no Windows needed. Run by .github/workflows/preview.yml with the folder for the
    pictures as its only argument.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>CustosPreviewShots</AssemblyName>
    <RootNamespace>Custos.Preview.Shots</RootNamespace>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Custos.Preview\Custos.Preview.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

</Project>
