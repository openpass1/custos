<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The menu bar icon of CUSTOS for every user who logs in: /Library/LaunchAgents/org.custos.menu.plist.
     The argument tray (with two dashes) starts the program with the icon only; the window opens from its menu. Not kept alive: after
     «Завершить CUSTOS» the icon comes back at the next login. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.custos.menu</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Custos.app/Contents/MacOS/Custos</string>
    <string>--tray</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
