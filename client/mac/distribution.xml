<?xml version="1.0" encoding="utf-8"?>
<!-- The installer of CUSTOS for macOS (productbuild): one installer for Macs with Apple silicon and with Intel,
     macOS 15 and newer, installed for the whole Mac. It holds two parts, Custos-arm64.pkg and Custos-x86_64.pkg (the
     same program built for each kind of processor); Installer puts only the one of this Mac, the user does not choose.
     mac/build-mac.sh puts the version in place of __VERSION__; the texts are in resources/<language>.lproj. -->
<installer-gui-script minSpecVersion="2">
  <title>CUSTOS</title>
  <license file="License.txt" mime-type="text/plain" />
  <conclusion file="conclusion.html" mime-type="text/html" />
  <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64" rootVolumeOnly="true" />
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false" />
  <volume-check>
    <allowed-os-versions>
      <os-version min="15.0" />
    </allowed-os-versions>
  </volume-check>
  <script><![CDATA[
    // Apple silicon: the processor has arm64 (also true when Installer itself runs under Rosetta). Intel Macs do
    // not know this key at all.
    function isAppleSilicon() {
      return system.sysctl('hw.optional.arm64') == 1;
    }
  ]]></script>
  <choices-outline>
    <line choice="org.custos.pkg.arm64" />
    <line choice="org.custos.pkg.x86_64" />
  </choices-outline>
  <choice id="org.custos.pkg.arm64" visible="false" enabled="false" title="CUSTOS (Apple silicon)"
          start_selected="isAppleSilicon()" selected="isAppleSilicon()">
    <pkg-ref id="org.custos.pkg.arm64" />
  </choice>
  <choice id="org.custos.pkg.x86_64" visible="false" enabled="false" title="CUSTOS (Intel)"
          start_selected="!isAppleSilicon()" selected="!isAppleSilicon()">
    <pkg-ref id="org.custos.pkg.x86_64" />
  </choice>
  <pkg-ref id="org.custos.pkg.arm64" version="__VERSION__" onConclusion="none">Custos-arm64.pkg</pkg-ref>
  <pkg-ref id="org.custos.pkg.x86_64" version="__VERSION__" onConclusion="none">Custos-x86_64.pkg</pkg-ref>
</installer-gui-script>
