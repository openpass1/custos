case "$1" in
  remove|purge)
    clear_install_marker
    if [ -L "$enable_link" ]; then
      enabled_unit=$(readlink -- "$enable_link")
      case "$enabled_unit" in
        "$unit_path"|"/lib/systemd/system/$unit")
          # An external installer can keep the link when switching the same service name to its own unit.
          if replacement=$(external_unit) && [ -f "$replacement" ]; then
            ln -sfnT -- "$replacement" "$enable_link"
          else
            rm -- "$enable_link"
          fi
          ;;
      esac
    fi
    if systemd_running && ! external_agent; then
      systemctl daemon-reload
    fi
    ;;
  abort-install)
    clear_install_marker
    ;;
esac
